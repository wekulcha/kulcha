# Domains
API_DOMAIN=api.wekulcha.ru
USER_DOMAIN=app.wekulcha.ru
ADMIN_DOMAIN=admin.wekulcha.online
SUPERADMIN_DOMAIN=superadmin.wekulcha.online
PUBLIC_API_URL=https://api.wekulcha.ru/api/v1
ACME_EMAIL=admin@wekulcha.ru

# Backend CORS (comma-separated)
KULCHA_CORS_ALLOWED_ORIGINS=https://app.wekulcha.ru,https://admin.wekulcha.online,https://superadmin.wekulcha.online

# Database
POSTGRES_DB=kulcha
POSTGRES_USER=kulcha
POSTGRES_PASSWORD=replace_with_strong_password

# Bots
KULCHA_USER_BOT_TOKEN=replace_user_bot_token
KULCHA_ADMIN_BOT_TOKEN=replace_admin_bot_token
KULCHA_SUPERADMIN_BOT_TOKEN=replace_superadmin_bot_token
KULCHA_SUPERADMIN_ALLOWED_IDS=
KULCHA_SUPERADMIN_MINI_APP_URL=https://superadmin.wekulcha.online
KULCHA_SUPPORT_LINK=https://t.me/wekulcha_sup_bot
KULCHA_SUPPORT_BOT_TOKEN=replace_support_bot_token
# ID супергруппы (часто -100…); см. бота поддержки
KULCHA_SUPPORT_GROUP_ID=-1003920291106
KULCHA_USER_MINI_APP_VERSION=20260416-1
# Optional outbound proxy for Telegram Bot API, e.g. http://user:pass@host:3128
TELEGRAM_PROXY_URL=blahblahblah

# Shared: backend + admin_bot (кнопки статуса заказа) + опционально другие внутренние вызовы
KULCHA_INTERNAL_API_SECRET=replace_same_secret_in_backend_and_admin_bot

# Backend: user_bot (GET /orders?userId= для команды «Статус заказа») — должен совпадать с KULCHA_BOT_API_SECRET на backend
KULCHA_BOT_API_SECRET=replace_bot_api_secret

# Yandex Object Storage
KULCHA_OBJECT_STORAGE_ENDPOINT=https://storage.yandexcloud.net
KULCHA_OBJECT_STORAGE_REGION=ru-central1
KULCHA_OBJECT_STORAGE_BUCKET=kulcha-main-menu-items
KULCHA_OBJECT_STORAGE_ACCESS_KEY_ID=replace_object_storage_access_key_id
KULCHA_OBJECT_STORAGE_SECRET_ACCESS_KEY=replace_object_storage_secret_access_key
KULCHA_OBJECT_STORAGE_PUBLIC_BASE_URL=https://kulcha-main-menu-items.storage.yandexcloud.net

# User Mini App auth
KULCHA_AUTH_ACCESS_SECRET=replace_auth_access_secret
KULCHA_AUTH_ACCESS_TTL_MINUTES=15
KULCHA_AUTH_REFRESH_TTL_DAYS=30
KULCHA_AUTH_COOKIE_DOMAIN=.wekulcha.ru
KULCHA_AUTH_COOKIE_SECURE=true
