# Пример переменных для Spring, auth_gateway и ботов (не коммитьте реальные секреты).
# Экспортируйте в окружение или передайте в оркестраторе (Docker/K8s).

export SPRING_PROFILES_ACTIVE="${SPRING_PROFILES_ACTIVE:-h2}"

export KULCHA_USER_BOT_TOKEN=""
export KULCHA_ADMIN_BOT_TOKEN=""

export KULCHA_INTERNAL_API_SECRET=""

# Spring: kulcha.security.bot-api-secret
# export KULCHA_BOT_API_SECRET=""
# export KULCHA_INTERNAL_API_SECRET уже используется и для internal API.

