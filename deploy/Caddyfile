{
    email {$ACME_EMAIL}
}

{$API_DOMAIN} {
    encode zstd gzip
    reverse_proxy backend:8000
}

{$USER_DOMAIN} {
    encode zstd gzip
    reverse_proxy user_panel:80
}

{$ADMIN_DOMAIN} {
    encode zstd gzip
    reverse_proxy admin_panel:80
}

{$SUPERADMIN_DOMAIN} {
    encode zstd gzip
    reverse_proxy superadmin_panel:80
}

# Kulcha Market runs in a separate compose project. The existing Kulcha gateway
# must be connected to that compose network:
# docker network connect kulcha-market_default kulcha-gateway || true
market.wekulcha.ru {
    encode zstd gzip
    reverse_proxy kulcha-market-user-panel:80
}

apimarket.wekulcha.ru {
    encode zstd gzip
    reverse_proxy kulcha-market-backend:8000
}

adminmarket.wekulcha.online {
    encode zstd gzip
    reverse_proxy kulcha-market-admin-panel:80
}

supmarket.wekulcha.online {
    encode zstd gzip
    reverse_proxy kulcha-market-superadmin-panel:80
}
